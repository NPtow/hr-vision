      "versionNonce": 273208622,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790894992474,
      "link": null,
      "locked": false,
      "text": "Три источника HR-проверки: живое интервью, внешнее AI или готовая запись. Это варианты сбора данных, а не три обязательных интервью.",
      "originalText": "Три источника HR-проверки: живое интервью, внешнее AI или готовая запись. Это варианты сбора данных, а не три обязательных интервью.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "02-screening--note-1",
      "type": "text",
      "x": 80,
      "y": 3650,
      "width": 2290,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#696b65",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
