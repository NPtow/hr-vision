      "roundness": null,
      "seed": 1043608976,
      "version": 1,
      "versionNonce": 1043608976,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790894992474,
      "link": null,
      "locked": false,
      "text": "* «Hair» пока прочитан как Hiring-скрининг с нанимающим менеджером. Отдельный технический этап и правила пропуска проверок остаются вопросами.",
      "originalText": "* «Hair» пока прочитан как Hiring-скрининг с нанимающим менеджером. Отдельный технический этап и правила пропуска проверок остаются вопросами.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
