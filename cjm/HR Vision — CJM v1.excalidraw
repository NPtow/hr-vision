      "isDeleted": false,
      "boundElements": [],
      "updated": 1790894992474,
      "link": null,
      "locked": false,
      "text": "Выбор кандидата → подготовка → выдача → решение → оформление → фактический выход. Эти события не равны.",
      "originalText": "Выбор кандидата → подготовка → выдача → решение → оформление → фактический выход. Эти события не равны.",
