dth":1.5,"roughness":0,"isDeleted":false,"fontSize":20,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Обводка = экран участника. B01…B27 = общие функциональные блоки. E\/H = представления кабинета компании; A = наша команда; C = кандидат.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Обводка = экран участника. B01…B27 = общие функциональные блоки. E\/H = представления кабинета компании; A = наша команда; C = кандидат.","height":25,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],"versionNonce":82060963,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"01-contacts--frame","boundElements":[],"x":220,"angle":0,"y":1920,"width":4600},{"seed":193230175,"strokeStyle":"solid","id":"01-contacts--note-1","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":20,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Колонки задают общую логику, а не синхронные сроки. Первые кандидаты идут дальше, пока продолжаются поиск и проверки остальных.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Колонки задают общую логику, а не синхронные сроки. Первые кандидаты идут дальше, пока продолжаются поиск и проверки остальных.","height":25,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],"versionNonce":193230175,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"01-contacts--frame","boundElements":[],"x":220,"angle":0,"y":1960,"width":4600},{"seed":612987061,"strokeStyle":"solid","id":"01-contacts--note-2","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":24,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"После передачи контакта клиент ведёт найм сам.\nЗдесь нет скрытого агентского сопровождения.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"После передачи контакта клиент ведёт найм сам.\nЗдесь нет скрытого агентского сопровождения.","height":60,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],"versionNonce":612987061,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"01-contacts--frame","boundElements":[],"x":2960,"angle":0,"y":1290,"width":1190},{"seed":255431582,"strokeStyle":"solid","id":"01-contacts--note-3","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":26,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Ключевые развилки · подробнее проверяем CV, HR, тестовое и встречу с НМ; доступ к материалам и актуальный интерес проверяются отдельно.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Ключевые развилки · подробнее проверяем CV, HR, тестовое и встречу с НМ; доступ к материалам и актуальный интерес проверяются отдельно.","height":32.5,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],"versionNonce":255431582,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"01-contacts--frame","boundElements":[],"x":220,"angle":0,"y":2040,"width":4600},{"seed":808924464,"strokeStyle":"solid","id":"01-contacts--note-4","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":24,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Граница стратегии\nПокупка контакта не включает найм до выхода. Опциональный переход в ATS или агентство\nтребует отдельного выбора услуги.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Граница стратегии\nПокупка контакта не включает найм до выхода. Опциональный переход в ATS или агентство требует отдельного выбора услуги.","height":90,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],