ервью","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Интервью","height":20,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["03-ats--edge-e33-label-group"],"versionNonce":981713579,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"03-ats--frame","boundElements":[],"x":2320,"angle":0,"y":9500,"width":360},{"isDeleted":false,"locked":false,"strokeColor":"#f4f1e8","link":null,"roughness":0,"groupIds":["03-ats--edge-e34-label-group"],"backgroundColor":"#f4f1e8","angle":0,"customData":{"role":"text-backdrop","textId":"03-ats--edge-e34-label"},"fillStyle":"solid","strokeWidth":0,"version":1,"roundness":null,"type":"rectangle","updated":1790894827121,"id":"03-ats--edge-e34-label-mask","x":2676,"seed":704360636,"boundElements":[],"y":9487,"opacity":100,"height":26,"width":150.97548828124999,"frameId":"03-ats--frame","strokeStyle":"solid","versionNonce":704360636},{"seed":958599710,"strokeStyle":"solid","id":"03-ats--edge-e34-label","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":16,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Подбор до выхода","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Подбор до выхода","height":20,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["03-ats--edge-e34-label-group"],"versionNonce":958599710,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"03-ats--frame","boundElements":[],"x":2680,"angle":0,"y":9490,"width":360},{"seed":705043412,"strokeStyle":"solid","id":"03-ats--note-0","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":20,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Обводка = экран участника. B01…B27 = общие функциональные блоки. E\/H = представления кабинета компании; A = наша команда; C = кандидат.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Обводка = экран участника. B01…B27 = общие функциональные блоки. E\/H = представления кабинета компании; A = наша команда; C = кандидат.","height":25,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],"versionNonce":705043412,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"03-ats--frame","boundElements":[],"x":220,"angle":0,"y":8920,"width":4600},{"seed":634569537,"strokeStyle":"solid","id":"03-ats--note-1","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":20,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Колонки задают общую логику, а не синхронные сроки. Первые кандидаты идут дальше, пока продолжаются поиск и проверки остальных.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Колонки задают общую логику, а не синхронные сроки. Первые кандидаты идут дальше, пока продолжаются поиск и проверки остальных.","height":25,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],"versionNonce":634569537,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"03-ats--frame","boundElements":[],"x":220,"angle":0,"y":8960,"width":4600},{"seed":18369656,"strokeStyle":"solid","id":"03-ats--note-2","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":24,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Без покупки услуги агентство не ведёт этот найм.\nПлатные переходы ниже остаются рабочей гипотезой.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Без покупки услуги агентство не ведёт этот найм.\nПлатные переходы ниже остаются рабочей гипотезой.","height":60,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],"versionNonce":18369656,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"03-ats--frame","boundElements":[],"x":2950,"angle":0,"y":8290,"width":1220},{"seed":60273968,"strokeStyle":"solid","id":"03-ats--note-3","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":26,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Ключевые развилки · бесплатный собственный поток и отдельные варианты покупки внешней ценности.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Ключевые развилки · бесплатный собственный поток и отдельные варианты покупки внешней ценности.","height":32.5,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],"versionNonce":60273968,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"03-ats--frame","boundElements":[],"x":220,"angle":0,"y":9040,"width":4600},{"seed":11625087,"strokeStyle":"solid","id":"03-ats--note-4","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":24,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Разделение данных\nСвои кандидаты и внешняя база имеют разные основания доступа. Отказ в вакансии не\nявляется разрешением на показ записи другим компаниям.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Разделение данных\nСвои кандидаты и внешняя база имеют разные основания доступа. Отказ в вакансии не является разрешением на показ записи другим компаниям.","height":90,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],"versionNonce":11625087,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"03-ats--frame","boundElements":[],"x":3680,"angle":0,"y":9240,"width":1100},{"seed":1065127372,"strokeStyle":"solid","id":"03-ats--note-5","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":24,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"За рамкой пилота\nПолная ATS, самостоятельные покупки и постоянный кабинет кандидата. Для первого запуска\nдопустима ручная передача материалов и статусов.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"За рамкой пилота\nПолная ATS, самостоятельные покупки и постоянный кабинет кандидата. Для первого запуска допустима ручная передача материалов и статусов.","height":90,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],"versionNonce":1065127372,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"03-ats--frame","boundElements":[],"x":3680,"angle":0,"y":9660,"width":1100},{"seed":546405124,"strokeStyle":"solid","id":"03-ats--note-6","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":20,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Рабочая модель по делегированию Никиты, не утверждение готовности продукта. Граница оффера\/договора: фиксируем условия, версии и статусы; юридическая подготовка и подписание снаружи.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Рабочая модель по делегированию Никиты, не утверждение готовности продукта. Граница оффера\/договора: фиксируем условия, версии и статусы; юридическая подготовка и подписание снаружи.","height":25,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":[],"versionNonce":546405124,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"03-ats--frame","boundElements":[],"x":220,"angle":0,"y":10080,"width":4600},{"seed":924122149,"strokeStyle":"solid","id":"03-ats--note-7","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":18,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Основания: GTM-дека 2.9, с. 4, 6–11, 15–17, 43, 54, 57–60; встреча с Мишей; правки Никиты. Детали и допущения: v2-основания.md. Под Hiring п