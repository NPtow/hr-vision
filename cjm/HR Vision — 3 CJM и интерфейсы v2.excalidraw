 запроса нужен для поставки внешней ценности. Первую очередь может обеспечивать текущая внутренняя ATS. Состав доступа внешних партнеров сюда не включен."},"fillStyle":"solid","strokeWidth":1.5,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1790894827121,"id":"05-screens--node-A02","x":6980,"seed":750290366,"boundElements":[],"y":4580,"opacity":100,"height":360,"width":680,"frameId":"05-screens--frame","strokeStyle":"solid","versionNonce":750290366},{"seed":728536778,"strokeStyle":"solid","id":"05-screens--node-A02-title","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":24,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"A02 \/ Заказы и работа команды","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"A02 \/ Заказы и работа команды","height":28.799999999999997,"link":null,"strokeColor":"#20211f","fillStyle":"solid","groupIds":["05-screens--group-A02"],"versionNonce":728536778,"textAlign":"left","fontFamily":2,"lineHeight":1.2,"frameId":"05-screens--frame","boundElements":[],"x":6998,"angle":0,"y":4598,"width":644},{"seed":499399157,"strokeStyle":"solid","id":"05-screens--node-A02-body","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":18,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"B01 · B02 · B03 · B26 · B27\nВ агентском входе ведется заказ до выхода; в базе и ATS контекст\nзапроса нужен для поставки внешней ценности. Первую очередь может\nобеспечивать текущая внутренняя ATS. Состав доступа внешних\nпартнеров сюда не включен.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"B01 · B02 · B03 · B26 · B27\nВ агентском входе ведется заказ до выхода; в базе и ATS контекст\nзапроса нужен для поставки внешней ценности. Первую очередь может\nобеспечивать текущая внутренняя ATS. Состав доступа внешних\nпартнеров сюда не включен.","height":117,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["05-screens--group-A02"],"versionNonce":499399157,"textAlign":"left","fontFamily":2,"lineHeight":1.3,"frameId":"05-screens--frame","boundElements":[],"x":6998,"angle":0,"y":4636.8000000000002,"width":644},{"seed":546594778,"strokeStyle":"solid","id":"05-screens--node-A02-refs","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":14,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"Наша команда\nКонтакты · Агентство · ATS","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"Наша команда\nКонтакты · Агентство · ATS","height":35,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["05-screens--group-A02"],"versionNonce":546594778,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"05-screens--frame","boundElements":[],"x":6998,"angle":0,"y":4763.8000000000002,"width":644},{"isDeleted":false,"locked":false,"strokeColor":"#20211f","link":null,"roughness":0,"groupIds":["05-screens--group-A03"],"backgroundColor":"#f4f1e8","angle":0,"customData":{"x":2480,"id":"A03","y":1080,"h":360,"title":"A03 \/ Общая база кандидатов","refs":"Наша команда\nКонтакты · Агентство · ATS","meta":{"definition":{"strategies":["contacts","agency","ats"],"id":"A03","note":"Общая база для трех входов: источник, разрешения, актуальность и сообщенный интерес. Обратная связь уточняет профиль и выдачу. Покупка контакта не открывает клиенту любые записи и внутренние заметки; клиентский исход может остаться неизвестным.","name":"Общая база кандидатов","role":"agency","modules":["B07","B08","B09","B15","B19","B20","B26"]},"screen":"A03"},"kind":"job","w":680,"body":"B07 · B08 · B09 · B15 · B19 · B20 · B26\nОбщая база для трех входов: источник, разрешения, актуальность и сообщенный интерес. Обратная связь уточняет профиль и выдачу. Покупка контакта не открывает 