ger","modules":["B08","B12","B13","B14","B17","B18","B19","B20"]},"screen":"E04"},"kind":"job","w":680,"body":"B08 · B12 · B13 · B14 · B17 · B18 · B19 · B20\nОдна композиция переиспользует профиль, доказательства и состояние конкретной вакансии. У нанимающего решения, уточнения и встреча; закрытые заметки HR не раскрываются автоматически. Добор B14 пока может происходить вне платформы."},"fillStyle":"solid","strokeWidth":1.5,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1790894827121,"id":"05-screens--node-E04","x":7780,"seed":135459053,"boundElements":[],"y":3700,"opacity":100,"height":360,"width":680,"frameId":"05-screens--frame","strokeStyle":"solid","versionNonce":135459053},{"seed":446109964,"strokeStyle":"solid","id":"05-screens--node-E04-title","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":24,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"E04 \/ Карточка рассмотрения кандидата","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"E04 \/ Карточка рассмотрения кандидата","height":28.799999999999997,"link":null,"strokeColor":"#20211f","fillStyle":"solid","groupIds":["05-screens--group-E04"],"versionNonce":446109964,"textAlign":"left","fontFamily":2,"lineHeight":1.2,"frameId":"05-screens--frame","boundElements":[],"x":7798,"angle":0,"y":3718,"width":644},{"seed":43764945,"strokeStyle":"solid","id":"05-screens--node-E04-body","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":18,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"B08 · B12 · B13 · B14 · B17 · B18 · B19 · B20\nОдна композиция переиспользует профиль, доказательства и состояние\nконкретной вакансии. У нанимающего решения, уточнения и встреча;\nзакрытые заметки HR не раскрываются автоматически. Добор B14 пока\nможет происходить вне платформы.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"B08 · B12 · B13 · B14 · B17 · B18 · B19 · B20\nОдна композиция переиспользует профиль, доказательства и состояние\nконкретной вакансии. У нанимающего решения, уточнения и встреча;\nзакрытые заметки HR не раскрываются автоматически. Добор B14 пока\nможет происходить вне платформы.","height":117,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["05-screens--group-E04"],"versionNonce":43764945,"textAlign":"left","fontFamily":2,"lineHeight":1.3,"frameId":"05-screens--frame","boundElements":[],"x":7798,"angle":0,"y":3756.8000000000002,"width":644},{"seed":972802623,"strokeStyle":"solid","id":"05-screens--node-E04-refs","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":14,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"НМ\nКонтакты · Агентство · ATS","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"НМ\nКонтакты · Агентство · ATS","height":35,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["05-screens--group-E04"],"versionNonce":972802623,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"05-screens--frame","boundElements":[],"x":7798,"angle":0,"y":3883.8000000000002,"width":644},{"isDeleted":false,"locked":false,"strokeColor":"#20211f","link":null,"roughness":0,"groupIds":["05-screens--group-E05"],"backgroundColor":"#f4f1e8","angle":0,"customData":{"x":80,"id":"E05","y":640,"h":360,"title":"E05 \/ Оффер и выход","refs":"НМ\nАгентство · ATS","meta":{"definition":{"strategies":["agency","ats"],"id":"E05","note":"Целевое представление, не обязательный экран первого запуска. В пилоте предложение, KPI и оформление ведет компания своими средствами. В CJM базы контактов эти работы продолжаются у клиента вне сервиса.","name":"Оффер и выход","role":"manager","modules":["B17","B19","B22","B23","B24","B25"]},"screen":"E05"},"kind":"job","w":680,"body":"B17 · B19 · B22 · B23 · B24 · B25\nЦелевое представление, не обязательный экран первого запуска. В пилоте предложение, KPI и оформление ведет компания своими средствами. В CJM базы контактов эти работы продолжаются у клиента вне сервиса."},"fillStyle":"solid","strokeWidth":1.5,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1790894827121,"id":"05-screens--node-E05","x":5380,"seed":904103149,"boundElements":[],"y":4140,"opacity":100,"height":360,"width":680,"frameId":"05-screens--frame","strokeStyle":"solid","versionNonce":904103149},{"seed":365225813,"strokeStyle":"solid","id":"05-screens--node-E05-title","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":24,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"E05 \/ Оффер и выход","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"E05 \/ Оффер и выход","height":28.799999999999997,"link":null,"strokeColor":"#20211f","fillStyle":"solid","groupIds":["05-screens--group-E05"],"versionNonce":365225813,"textAlign":"left","fontFamily":2,"lineHeight":1.2,"frameId":"05-screens--frame","boundElements":[],"x":5398,"angle":0,"y":4158,"width":644},{"seed":784655264,"strokeStyle":"solid","id":"05-screens--node-E05-body","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":18,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"B17 · B19 · B22 · B23 · B24 · B25\nЦелевое представление, не обязательный экран первого запуска. В\nпилоте предложение, KPI и оформление ведет компания своими\nсредствами. В CJM базы контактов эти работы продолжаются у клиента\nвне сервиса.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"B17 · B19 · B22 · B23 · B24 · B25\nЦелевое представление, не обязательный экран первого запуска. В\nпилоте предложение, KPI и оформление ведет компания своими\nсредствами. В CJM базы контактов эти работы продолжаются у клиента\nвне сервиса.","height":117,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["05-screens--group-E05"],"versionNonce":784655264,"textAlign":"left","fontFamily":2,"lineHeight":1.3,"frameId":"05-screens--frame","boundElements":[],"x":5398,"angle":0,"y":4196.8000000000002,"width":644},{"seed":558258871,"strokeStyle":"solid","id":"05-screens--node-E05-refs","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":14,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"НМ\nАгентство · ATS","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"НМ\nАгентство · ATS","height":35,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["05-screens--group-E05"],"versionNonce":558258871,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"05-screens--frame","boundElements":[],"x":5398,"angle":0,"y":4323.8000000000002,"width":644},{"isDeleted":false,"locked":false,"strokeColor":"#20211f","link":null,"roughness":0,"groupIds":["05-screens--group-H01"],"backgroundColor":"#f4f1e8","angle":0,"customData":{"x":880,"id":"H01","y":640,"h":360,"title":"H01 \/ Вакансии и очередь HR","refs":"HR компании\nКонтакты · Агентство · ATS","meta":{"definition":{"strategies":["contacts","agency","ats"],"id":"H01","note":"Рабочее представление общего кабинета компании. HR уточняет бриф, ведет вакансии и ожидающие действия; в ATS также добавляет поток. В базе на этом экране возвращается только сообщенный исход найма. Внутренняя очередь агентства клиенту не открывается автоматически.","name":"Вакансии и очередь HR","role":"hr","modules":["B01","B02","B03","B07","B17","B20","B25","B27"]},"screen":"H01"},"kind":"job","w":680,"body":"B01 · B02 · B03 · B07 · B17 · B20 · B25 · B27\nРабочее представление общего кабинета компании. HR уточняет бриф, ведет вакансии и ожидающие действия; в ATS также добавляет поток. В базе на этом экране возвращается только сообщенный исход найма. Внутренняя очередь агентства клиенту не открывается автоматически."},"fillStyle":"solid","strokeWidth":1.5,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1790894827121,"id":"05-screens--node-H01","x":6180,"seed":544098446,"boundElements":[],"y":4140,"opacity":100,"height":360,"width":680,"frameId":"05-screens--frame","strokeStyle":"solid","versionNonce":544098446},{"seed":610402127,"strokeStyle":"solid","id":"05-screens--node-H01-title","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":24,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"H01 \/ Вакансии и очередь HR","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"H01 \/ Вакансии и очередь HR","height":28.799999999999997,"link":null,"strokeColor":"#20211f","fillStyle":"solid","groupIds":["05-screens--group-H01"],"versionNonce":610402127,"textAlign":"left","fontFamily":2,"lineHeight":1.2,"frameId":"05-screens--frame","boundElements":[],"x":6198,"angle":0,"y":4158,"width":644},{"seed":50928990,"strokeStyle":"solid","id":"05-screens--node-H01-body","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":18,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"B01 · B02 · B03 · B07 · B17 · B20 · B25 · B27\nРабочее представление общего кабинета компании. HR уточняет бриф,\nведет вакансии и ожидающие действия; в ATS также добавляет поток. В\nбазе на этом экране возвращается только сообщенный исход найма.\nВнутренняя очередь агентства клиенту не открывается автоматически.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"B01 · B02 · B03 · B07 · B17 · B20 · B25 · B27\nРабочее представление общего кабинета компании. HR уточняет бриф,\nведет вакансии и ожидающие действия; в ATS также добавляет поток. В\nбазе на этом экране возвращается только сообщенный исход найма.\nВнутренняя очередь агентства клиенту не открывается автоматически.","height":117,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["05-screens--group-H01"],"versionNonce":50928990,"textAlign":"left","fontFamily":2,"lineHeight":1.3,"frameId":"05-screens--frame","boundElements":[],"x":6198,"angle":0,"y":4196.8000000000002,"width":644},{"seed":949644732,"strokeStyle":"solid","id":"05-screens--node-H01-refs","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":14,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"HR компании\nКонтакты · Агентство · ATS","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"HR компании\nКонтакты · Агентство · ATS","height":35,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["05-screens--group-H01"],"versionNonce":949644732,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"05-screens--frame","boundElements":[],"x":6198,"angle":0,"y":4323.8000000000002,"width":644},{"isDeleted":false,"locked":false,"strokeColor":"#20211f","link":null,"roughness":0,"groupIds":["05-screens--group-H02"],"backgroundColor":"#f4f1e8","angle":0,"customData":{"x":1680,"id":"H02","y":640,"h":360,"title":"H02 \/ Поток кандидатов","refs":"HR компании\nКонтакты · Агентство · ATS","meta":{"definition":{"strategies":["contacts","agency","ats"],"id":"H02","note":"В ATS HR добавляет своих кандидатов и ведет пары; в агентстве получает готовые подборки без обязательной загрузки. В базе уточняет запрос, интерес и разрешенный доступ перед получением контакта. Все указанные модули не обязаны быть активны одновременно во всех GTM.","name":"Поток кандидатов","role":"hr","modules":["B03","B07","B08","B09","B15","B17","B19","B26"]},"screen":"H02"},"kind":"job","w":680,"body":"B03 · B07 · B08 · B09 · B15 · B17 · B19 · B26\nВ ATS HR добавляет своих кандидатов и ведет пары; в агентстве получает готовые подборки без обязательной загрузки. В базе уточняет запрос, интерес и разрешенный доступ перед получением контакта. Все указанные модули не обязаны быть активны одновременно во всех GTM."},"fillStyle":"solid","strokeWidth":1.5,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1790894827121,"id":"05-screens--node-H02","x":6980,"seed":253144346,"boundElements":[],"y":4140,"opacity":100,"height":360,"width":680,"frameId":"05-screens--frame","strokeStyle":"solid","versionNonce":253144346},{"seed":751984858,"strokeStyle":"solid","id":"05-screens--node-H02-title","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":24,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"H02 \/ Поток кандидатов","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"H02 \/ Поток кандидатов","height":28.799999999999997,"link":null,"strokeColor":"#20211f","fillStyle":"solid","groupIds":["05-screens--group-H02"],"versionNonce":751984858,"textAlign":"left","fontFamily":2,"lineHeight":1.2,"frameId":"05-screens--frame","boundElements":[],"x":6998,"angle":0,"y":4158,"width":644},{"seed":1005133054,"strokeStyle":"solid","id":"05-screens--node-H02-body","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":18,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"B03 · B07 · B08 · B09 · B15 · B17 · B19 · B26\nВ ATS HR добавляет своих кандидатов и ведет пары; в агентстве\nполучает готовые подборки без обязательной загрузки. В базе уточняет\nзапрос, интерес и разрешенный доступ перед получением контакта. Все\nуказанные модули не обязаны быть активны одновременно во всех GTM.","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"B03 · B07 · B08 · B09 · B15 · B17 · B19 · B26\nВ ATS HR добавляет своих кандидатов и ведет пары; в агентстве\nполучает готовые подборки без обязательной загрузки. В базе уточняет\nзапрос, интерес и разрешенный доступ перед получением контакта. Все\nуказанные модули не обязаны быть активны одновременно во всех GTM.","height":117,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["05-screens--group-H02"],"versionNonce":1005133054,"textAlign":"left","fontFamily":2,"lineHeight":1.3,"frameId":"05-screens--frame","boundElements":[],"x":6998,"angle":0,"y":4196.8000000000002,"width":644},{"seed":372723649,"strokeStyle":"solid","id":"05-screens--node-H02-refs","strokeWidth":1.5,"roughness":0,"isDeleted":false,"fontSize":14,"opacity":100,"verticalAlign":"top","updated":1790894827121,"locked":false,"text":"HR компании\nКонтакты · Агентство · ATS","version":1,"autoResize":false,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"originalText":"HR компании\nКонтакты · Агентство · ATS","height":35,"link":null,"strokeColor":"#696b65","fillStyle":"solid","groupIds":["05-screens--group-H02"],"versionNonce":372723649,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":"05-screens--frame","boundElements":[],"x":6998,"angle":0,"y":4323.8000000000002,"width":644},{"isDeleted":false,"locked":false,"strokeColor":"#20211f","link":null,"roughness":0,"groupIds":["05-screens--group-H03"],"backgroundColor":"#f4f1e8","angle":0,"customData":{"x":2480,"id":"H03","y":640,"h":360,"title":"H03 \/ Рабочее место скрининга","refs":"HR компании\nКонтакты · Агентство · ATS","meta":{"definition":{"strategies":["contacts","agency","ats"],"id":"H03","note":"Профессиональное представление карточки кандидата для HR. Готовый профиль позволяет не повторять собранные проверки. В агентском сценарии многие действия выполняются внутренней командой на A04, а HR клиента видит переданный результат.","name":"Рабочее место скрининга","role":"hr","modules":["B08","B09","B10","B11","B12","B13","B14","B17","B18"]},"screen":"H03"},"kind":"job","w":680,"body":"B08 · B0