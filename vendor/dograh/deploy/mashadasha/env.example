# New-install template only. Never overwrite an existing /var/lib/dograh/.env.local.
# init_environment.py creates missing secrets once; the real file must be mode 600.
# Values below are placeholders, never usable production credentials.
PUBLIC_HOST=dograh.158-160-179-53.sslip.io
PUBLIC_BASE_URL=https://dograh.158-160-179-53.sslip.io
STORAGE_PUBLIC_BASE_URL=https://dograh-files.158-160-179-53.sslip.io
DOGRAH_STATE_DIR=/var/lib/dograh
DOGRAH_API_PORT=18080
DOGRAH_UI_PORT=13010
DOGRAH_STORAGE_PORT=19000
POSTGRES_PASSWORD=replace_with_random_hex_32_bytes
REDIS_PASSWORD=replace_with_random_hex_32_bytes
MINIO_ROOT_USER=dograh
MINIO_ROOT_PASSWORD=replace_with_random_hex_32_bytes
OSS_JWT_SECRET=replace_with_random_hex_64_bytes
TURN_SECRET=replace_with_random_hex_32_bytes
TTS_AUTH_TOKEN=replace_with_random_hex_32_bytes
# Enable both flags and the compose voice profile only after checking TURN reachability.
ENABLE_COTURN=false
FORCE_TURN_RELAY=false
# Verified deployment address on 2026-10-06; recheck on a different server.
TURN_HOST=158.160.193.212
TURN_PUBLIC_IP=158.160.193.212
# Signup off, MPS off, concurrency 1 and the per-node response gate are fixed in compose.yaml.
