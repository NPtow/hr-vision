+    def _caller_message_count(self) -> int:
+        """Count caller answers, excluding the engine's synthetic idle prompts.
+
+        Text chat restores its checkpoint and enters the current node *before*
+        appending the pending user message, so the same watermark works for
+        both a long-lived voice pipeline and per-turn text pipelines.
+        """
+        from api.services.workflow.conversation_history import _get_role_and_content
+
+        synthetic_idle_prompts = {
+            "The user has been quiet. Politely and briefly ask if they're still there in the language that the user has been speaking so far.",
+            "The user has been quiet. We will be disconnecting the call now. Wish them a good day in the language that the user has been speaking so far.",
+        }
+        if self.context is None:
+            return 0
+        return sum(
+            role == "user" and bool(content and content.strip())
+            and content not in synthetic_idle_prompts
+            for role, content in (
+                _get_role_and_content(message)
+                for message in self.context.get_messages()
+            )
+        )
 
