+async def _finish_text_chat_pipeline(*, engine, task, runner_task) -> None:
+    """Keep inference alive until a natural end has finished extracting results."""
+    try:
+        # The final response can be idle while the shielded end-call task is
+        # still extracting variables. Cancelling the per-turn pipeline here
+        # closes its shared LLM and checkpoints an incomplete gathered_context.
+        # _end_call owns its bounded extraction timeout and queues EndFrame; it
+        # does not wait for this runner, so awaiting it does not form a cycle.
+        shutdown_task = engine._shutdown_task
+        if shutdown_task is not None:
+            try:
+                await asyncio.shield(shutdown_task)
+            except asyncio.CancelledError:
+                # Cancellation aborts this turn. Settle the shielded extraction
+                # before its pipeline/LLM is closed, rather than orphaning it.
+                shutdown_task.cancel()
+                await asyncio.gather(shutdown_task, return_exceptions=True)
+                raise
+    finally:
+        if not task.has_finished():
+            await task.cancel(reason=TEXT_CHAT_INTERNAL_CANCEL_REASON)
+        await runner_task
+
