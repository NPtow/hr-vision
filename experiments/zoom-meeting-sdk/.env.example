# Copy to .env.local. Never put these values into frontend/VITE variables.
# General app with Meeting SDK enabled: CURRENT Client ID / Client Secret.
# Legacy SDK Key / SDK Secret are no longer supported.
ZOOM_MEETING_SDK_CLIENT_ID=
ZOOM_MEETING_SDK_CLIENT_SECRET=

# A DIFFERENT Server-to-Server OAuth app for this same paid Zoom account.
# Minimum granular scopes:
# meeting:write:meeting:admin
# user:read:token:admin
# cloud_recording:read:list_recording_files:admin
ZOOM_S2S_ACCOUNT_ID=
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=
# Existing licensed host ID or email within that same account.
ZOOM_HOST_USER_ID=

# Host-start acceptance remains required: current Zoom FAQ describes user OAuth
# for embedded ZAK. If S2S ZAK is rejected, stop and configure the documented
# user-OAuth flow; never change accounts or silently promote a guest.
