[Unit]
Description=HR Vision materials reconciliation scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hr-vision
Group=hr-vision
WorkingDirectory=/opt/hr-vision-api/current
EnvironmentFile=/etc/hr-vision/materials.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/hr-vision-materials/venv/bin/python -m materials_runtime scheduler
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryHigh=96M
MemoryMax=128M
TasksMax=32
StateDirectory=hr-vision-api
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/hr-vision-api
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
