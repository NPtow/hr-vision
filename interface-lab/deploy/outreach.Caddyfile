# Dedicated static origin; no shared outreach Caddy restart required.
{
	auto_https off
	admin 127.0.0.1:2139
}

http://:8381 {
	bind 127.0.0.1 10.130.0.18
	@trusted {
		remote_ip 127.0.0.1 10.130.0.28
		host hr-vision.158-160-179-53.sslip.io mashadasha.tech
	}
	handle @trusted {
		@recruiterLegacy {
			host mashadasha.tech
			path /iframe.html
			query workspace=recruiter
		}
		redir @recruiterLegacy "https://hr-vision.158-160-179-53.sslip.io{uri}" 302
		redir /employer "/iframe.html?id=hr-vision-product--manager&viewMode=story&auth=login" 302
		redir /account/candidate "/iframe.html?id=hr-vision-product--candidate&viewMode=story" 302
		redir /candidate/ /candidate 308
		@publicPages {
			host mashadasha.tech
			path / /candidate
			not query path=*
		}
		handle @publicPages {
			root * /srv/hr-vision-company-demo/current
			rewrite * /index.html
			encode zstd gzip
			header Cache-Control "no-cache"
			file_server
		}
		@publicAssets {
			host mashadasha.tech
			path /site-assets/* /assets/hr-vision.svg /assets/play.svg /assets/roboto-flex.ttf /favicon.ico /favicon.svg /favicon-32.png /favicon-48.png /apple-touch-icon.png /safari-pinned-tab.svg
		}
		handle @publicAssets {
			root * /srv/hr-vision-company-demo/current
			encode zstd gzip
			header Cache-Control "no-cache"
			file_server
		}
		@mockupStory {
			path /iframe.html
			not query id=hr-vision-product--start id=hr-vision-product--manager id=hr-vision-product--candidate
		}
		redir @mockupStory "https://hr-vision-lab.158-160-179-53.sslip.io{uri}" 302
		@mockupCatalog {
			path /
			query path=*
			not query path=/story/hr-vision-product--start path=/story/hr-vision-product--manager path=/story/hr-vision-product--candidate
		}
		redir @mockupCatalog "https://hr-vision-lab.158-160-179-53.sslip.io{uri}" 302
		@intake path /api/hr/intake /api/hr/employer/intake
		handle @intake {
			request_body {
				max_size 12MB
			}
			reverse_proxy 127.0.0.1:8391
		}
		handle /api/hr/candidate/resume {
			request_body {
				max_size 7MB
			}
			reverse_proxy 127.0.0.1:8391
		}
		handle /api/hr/recruiter/candidates {
			request_body {
				max_size 7MB
			}
			reverse_proxy 127.0.0.1:8391
		}
		handle /api/hr/employer/vacancies/import {
			request_body {
				max_size 7MB
			}
			reverse_proxy 127.0.0.1:8391
		}
		@vacancyWrite path /api/hr/employer/vacancies /api/hr/employer/vacancies/update
		handle @vacancyWrite {
			request_body {
				max_size 128KB
			}
			reverse_proxy 127.0.0.1:8391
		}
		handle /api/hr/* {
			request_body {
				max_size 32KB
			}
			reverse_proxy 127.0.0.1:8391
		}
		handle {
		root * /srv/hr-vision/current
		encode zstd gzip
		header Cache-Control "no-cache"
		header X-Robots-Tag "noindex, nofollow"
		@landing expression `{http.request.uri.path} == "/" && {http.request.uri.query} == ""`
		redir @landing "/iframe.html?id=hr-vision-product--start&viewMode=story" 302
		file_server
		}
	}
	@mockups {
		remote_ip 127.0.0.1 10.130.0.28
		host hr-vision-lab.158-160-179-53.sslip.io
	}
	handle @mockups {
		redir /demos/company-v1 /demos/company-v1/ 308
		handle_path /demos/company-v1/* {
			root * /srv/hr-vision-company-demo/current
			encode zstd gzip
			header Cache-Control "no-cache"
			header X-Robots-Tag "noindex, nofollow"
			file_server
		}
		handle /api/* {
			respond "No API on the mockup site" 404
		}
		handle {
			@serviceStory query id=hr-vision-product--start id=hr-vision-product--manager id=hr-vision-product--candidate
			redir @serviceStory "https://hr-vision.158-160-179-53.sslip.io{uri}" 302
			@serviceCatalog query path=/story/hr-vision-product--start path=/story/hr-vision-product--manager path=/story/hr-vision-product--candidate
			redir @serviceCatalog "https://hr-vision.158-160-179-53.sslip.io{uri}" 302
			root * /srv/hr-vision-mockups/current
			encode zstd gzip
			header Cache-Control "no-cache"
			header X-Robots-Tag "noindex, nofollow"
			@landing expression `{http.request.uri.path} == "/" && {http.request.uri.query} == ""`
			redir @landing "/iframe.html?id=hr-vision-employer-menu--gallery&viewMode=story&menu=sidebar" 302
			file_server
		}
	}
	handle {
		respond "Forbidden" 403
	}
}
