# Reference only: the service reads /etc/hr-vision/api.env via systemd.
# Generate a private team key on the server. Never commit the real value.
HR_TEAM_KEY=
HR_PORT=8391
HR_ORIGIN=https://hr-vision.158-160-179-53.sslip.io
HR_DATA_DIR=/var/lib/hr-vision-api
HR_VIDEO_ENABLED=0
DAILY_API_KEY=
# Telegram uses the existing API worker, never a second standalone poller.
# Keep disabled until configured; do not commit real credentials.
HR_NOTIFICATIONS_ENABLED=0
HR_TELEGRAM_BOT_TOKEN=
HR_TELEGRAM_BOT_USERNAME=
HR_TELEGRAM_POLLING=0
HR_TELEGRAM_WEBHOOK_SECRET=
# Outreach's existing local Xray SOCKS proxy; applies only to Telegram requests.
# HR_TELEGRAM_PROXY_URL=socks5h://127.0.0.1:10808
