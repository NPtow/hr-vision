# Reference only: the service reads /etc/hr-vision/api.env via systemd.
# Generate a private team key on the server. Never commit the real value.
HR_TEAM_KEY=
HR_PORT=8391
HR_ORIGIN=https://hr-vision.158-160-179-53.sslip.io
HR_DATA_DIR=/var/lib/hr-vision-api
HR_VIDEO_ENABLED=0
DAILY_API_KEY=
# Telegram uses the existing API worker, never a second standalone poller.
# Keep disabled until configured; do not commit real credentials.
HR_NOTIFICATIONS_ENABLED=0
HR_TELEGRAM_BOT_TOKEN=
HR_TELEGRAM_BOT_USERNAME=
HR_TELEGRAM_POLLING=0
HR_TELEGRAM_WEBHOOK_SECRET=
# Outreach's existing local Xray SOCKS proxy; applies only to Telegram requests.
# HR_TELEGRAM_PROXY_URL=socks5h://127.0.0.1:10808
# Vacancy preview extraction. Server-only credentials; never ship in frontend.
# Role alias "extractor" resolves through this per-environment configuration.
HR_LLM_BASE_URL=
HR_LLM_API_KEY=
HR_LLM_MODEL=
# CV roles resolve separately; does not change vacancy extraction's model.
HR_CV_MODEL=gpt-6.1-sol
# Optional overrides; absent values reuse HR_LLM_BASE_URL/HR_LLM_API_KEY.
# HR_CV_LLM_BASE_URL=
# HR_CV_LLM_API_KEY=
# Browser-based HH campaigns use the existing hh-daily owner on this host.
# The bridge must be installed and calibrated against an authorized employer UI.
HR_HH_BROWSER_URL=http://127.0.0.1:8140
HR_HH_BROWSER_ACCOUNT=
HR_HH_BROWSER_TOKEN=
HR_HH_BROWSER_WORKER_ENABLED=0
HR_HH_BROWSER_SENDING_ENABLED=0
# Optional separate private worker HTTP credential. Never use the team key here.
HR_HH_OUTREACH_WORKER_SECRET=
