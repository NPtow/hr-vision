# Generate a different random token for every calling service; {} fails closed.
TRANSCRIPTION_API_KEYS={}
# Required for the asr Compose profile; normalization-only needs no broker.
# Dedicated vhost and credentials, outside the repository. No default guest key.
TRANSCRIPTION_BROKER_URL=
TRANSCRIPTION_PORT=8093
# No ASR provider/model is selected. Normalization remains available without ASR.
# Full configured /audio/transcriptions endpoint of a compatible inference service.
TRANSCRIPTION_ASR_URL=
TRANSCRIPTION_ASR_MODEL=
TRANSCRIPTION_ASR_API_KEY=
TRANSCRIPTION_ASR_RESPONSE_FORMAT=verbose_json
TRANSCRIPTION_ALLOW_INSECURE_ASR_HTTP=false

# Independent SpeechKit ASR deployment; existing normalizer keeps backend_kind=http.
TRANSCRIPTION_BACKEND_KIND=http
TRANSCRIPTION_SPEECHKIT_API_KEY=
TRANSCRIPTION_SPEECHKIT_FOLDER_ID=
TRANSCRIPTION_SPEECHKIT_MODEL=general
TRANSCRIPTION_SPEECHKIT_LANGUAGE=ru-RU
TRANSCRIPTION_SPEECHKIT_SPEAKER_LABELING=false
TRANSCRIPTION_SPEECHKIT_CONFIG_REVISION=1
TRANSCRIPTION_STAGING_S3_BUCKET=
TRANSCRIPTION_STAGING_S3_PREFIX=speechkit-staging/
TRANSCRIPTION_STAGING_S3_ACCESS_KEY=
TRANSCRIPTION_STAGING_S3_SECRET_KEY=
# Explicit credentials above or standard AWS credential chain.
TRANSCRIPTION_MEDIA_MAX_DURATION_SECONDS=14400
TRANSCRIPTION_MEDIA_MAX_AUDIO_BYTES=1073741824
TRANSCRIPTION_MEDIA_TIMEOUT_SECONDS=900
TRANSCRIPTION_MAX_INPUT_BYTES=1073741824

# Deepgram is the first live provider; SpeechKit remains an optional adapter.
TRANSCRIPTION_DEEPGRAM_API_KEY=
TRANSCRIPTION_DEEPGRAM_MODEL=nova-3
TRANSCRIPTION_DEEPGRAM_LANGUAGE=ru
TRANSCRIPTION_DEEPGRAM_DIARIZE=true
TRANSCRIPTION_DEEPGRAM_DIARIZE_MODEL=v2
TRANSCRIPTION_DEEPGRAM_CONFIG_REVISION=1
