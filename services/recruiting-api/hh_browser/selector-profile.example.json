{
  "version": 1,
  "name": "fixture-only-replace-with-observed-hh-employer-dom",
  "calibrated": false,
  "guards": {"captcha": ["[data-test='captcha']"], "login": ["[data-test='login']"]},
  "identity": {
    "accountId": {"selector": "[data-account-id]", "attribute": "data-account-id"},
    "role": {"selector": "[data-role]", "attribute": "data-role"},
    "employerRole": "employer"
  },
  "resume": {
    "resumeId": {"selector": "[data-resume-id]", "attribute": "data-resume-id"},
    "name": {"selector": "h1"},
    "cvText": {"selector": "[data-test='cv-text']"},
    "fullCVMarker": {"selector": "[data-test='full-cv']"},
    "chatUrl": {"selector": "[data-test='chat-link']", "attribute": "href"}
  },
  "applicants": {
    "rows": {"selector": "[data-test='applicant']"},
    "vacancyId": {"selector": "[data-vacancy-id]", "attribute": "data-vacancy-id"},
    "resumeUrl": {"selector": "[data-test='resume-link']", "attribute": "href"},
    "responseId": {"selector": "[data-response-id]", "attribute": "data-response-id"},
    "chatUrl": {"selector": "[data-test='chat-link']", "attribute": "href"},
    "next": {"selector": "[data-test='next']", "attribute": "href"}
  },
  "chat": {
    "resumeId": {"selector": "[data-resume-id]", "attribute": "data-resume-id"},
    "chatId": {"selector": "[data-chat-id]", "attribute": "data-chat-id"},
    "composer": {"selector": "textarea"},
    "composerValue": "input",
    "send": {"selector": "[data-test='send']"},
    "messages": {"selector": "[data-outgoing='true']"},
    "messageId": {"selector": "[data-message-id]", "attribute": "data-message-id"},
    "messageText": {"selector": "[data-test='message-text']"}
  }
}
