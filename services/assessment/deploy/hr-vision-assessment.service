[Unit]
Description=HR Vision production Jev assessment
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
DynamicUser=yes
StateDirectory=hr-vision-assessment
StateDirectoryMode=0700
WorkingDirectory=/opt/hr-vision-assessment/current
EnvironmentFile=/etc/hr-vision/assessment.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/hr-vision-assessment/current/app.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=65
MemoryMax=192M
MemorySwapMax=0
CPUQuota=50%
TasksMax=32
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
LogRateLimitIntervalSec=30s
LogRateLimitBurst=60

[Install]
WantedBy=multi-user.target
