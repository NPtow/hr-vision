# Copy to /etc/md-materials/source.env mode 0600. Source never receives HR DB path.
SOURCE_DAILY_API_KEYS={"REPLACE_PORTAL_SOURCE_TOKEN_MIN_32_ASCII":"portal"}
SOURCE_DAILY_DAILY_KEY=REPLACE_DAILY_KEY
# Preserve the existing Daily webhook HMAC secret when forwarding webhook delivery.
SOURCE_DAILY_DAILY_WEBHOOK_HMAC=
SOURCE_DAILY_CONNECTION_ID=daily
SOURCE_DAILY_DEFAULT_STORAGE_POLICY=remote
SOURCE_DAILY_CORE_TOKEN=REPLACE_SOURCE_CORE_TOKEN_MIN_32_ASCII
# Existing RabbitMQ only; create isolated vhost/user manually, do not change others.
SOURCE_DAILY_BROKER_URL=amqp://md-source-daily:REPLACE_PASSWORD@127.0.0.1:5672/source-daily
# Normalization may use the separately managed transcription service once its port is known.
SOURCE_DAILY_TRANSCRIPTION_URL=
SOURCE_DAILY_TRANSCRIPTION_TOKEN=
SOURCE_DAILY_ENABLE_ASR=false
SOURCE_DAILY_DAILY_TRANSCRIPTION_MODEL=
SOURCE_DAILY_S3_BUCKET=
SOURCE_DAILY_S3_PREFIX=materials
SOURCE_DAILY_S3_ENDPOINT=
SOURCE_DAILY_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
