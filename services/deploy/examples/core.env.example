# Copy to /etc/md-materials/core.env mode 0600, replace every REPLACE value.
# The existing HR database MUST exist; core cannot initialize an empty business DB.
CORE_HR_DATABASE=/var/lib/hr-vision-api/state.sqlite3
CORE_PRINCIPALS_JSON=[{"token":"REPLACE_PORTAL_CORE_TOKEN_MIN_32_ASCII","name":"portal","role":"portal"},{"token":"REPLACE_SOURCE_CORE_TOKEN_MIN_32_ASCII","name":"daily","role":"source","provider":"daily","connection_id":"daily"}]
CORE_DEFAULT_CONNECTIONS_JSON={"daily":"daily"}
CORE_S3_BUCKET=
CORE_S3_PREFIX=materials
CORE_S3_ENDPOINT=
CORE_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
