[Unit]
Description=Independent HR materials core and Daily source containers
Requires=docker.service
After=docker.service network-online.target rabbitmq-server.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/md-materials/deploy
ExecStartPre=/usr/bin/python3 /opt/md-materials/deploy/ctl.py config
ExecStart=/usr/bin/python3 /opt/md-materials/deploy/ctl.py up
ExecStop=/usr/bin/python3 /opt/md-materials/deploy/ctl.py stop
TimeoutStartSec=180
TimeoutStopSec=330
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/md-materials
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
