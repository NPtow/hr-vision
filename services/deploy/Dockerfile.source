# Frozen multi-arch Python 3.12.13-slim-bookworm index, retrieved 2026-10-25.
FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
WORKDIR /app
COPY . /app/
RUN sha256sum --strict -c SHA256SUMS \
    && python -m pip install --no-cache-dir --no-compile --require-hashes --only-binary=:all: -r requirements-runtime.lock \
    && groupadd --gid 19402 source-daily \
    && useradd --uid 19402 --gid 19402 --no-create-home --shell /usr/sbin/nologin source-daily
USER 19402:19402
STOPSIGNAL SIGTERM
ENTRYPOINT ["python", "-m", "source_daily"]
