[Unit]
Description=HR Vision vacancy level and importance profile
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
DynamicUser=yes
StateDirectory=hr-vision-vacancy-profile
StateDirectoryMode=0700
WorkingDirectory=/opt/hr-vision-vacancy-profile/current
EnvironmentFile=/etc/hr-vision/vacancy-profile.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m vacancy_profile.api
Restart=on-failure
RestartSec=5
TimeoutStopSec=130
KillSignal=SIGINT
MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
TasksMax=32
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
LogRateLimitIntervalSec=30s
LogRateLimitBurst=60

[Install]
WantedBy=multi-user.target
