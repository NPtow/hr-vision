[Unit]
Description=Stateless private Zoom provider API
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=true
WorkingDirectory=/opt/hr-vision-materials/services/zoom/current
EnvironmentFile=/etc/hr-vision-services/zoom.env
ExecStart=/opt/hr-vision-materials/venv/bin/python /opt/hr-vision-materials/services/zoom/current/run.py zoom
CacheDirectory=hr-vision-zoom
CacheDirectoryMode=0700
Environment=ZOOM_API_TEMP_ROOT=/var/cache/hr-vision-zoom
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
TemporaryFileSystem=/tmp:rw,noexec,nosuid,nodev,size=64M,mode=1777
InaccessiblePaths=-/var/lib/hr-vision-api -/etc/hr-vision-services/core.env -/etc/hr-vision-api
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=256M
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
