[Unit]
Description=HR Vision durable completion delivery to data services
After=network-online.target hr-vision-data-services.service
Wants=network-online.target

[Service]
Type=simple
User=hr-vision
Group=hr-vision
WorkingDirectory=/opt/hr-vision-api/current
EnvironmentFile=/etc/hr-vision/api.env
EnvironmentFile=/etc/hr-vision/core-source-portal.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/hr-vision-materials/venv/bin/python -m core_source_outbox
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
MemoryHigh=96M
MemoryMax=128M
TasksMax=32
StateDirectory=hr-vision-api
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/hr-vision-api
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
